# ---- Supabase ----
# From your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ---- Resend (transactional email) ----
RESEND_API_KEY=
EMAIL_FROM="SADEEM <hello@yourdomain.com>"
# Team mailbox that receives lead/booking/application notifications
TEAM_NOTIFY_TO=team@yourdomain.com
# Optional. Used to sign marketing unsubscribe links. Falls back to service role key if omitted.
EMAIL_UNSUBSCRIBE_SECRET=

# ---- Google Calendar (Phase 5) ----
GOOGLE_SA_EMAIL=
# Paste the private_key from the service account JSON (multiline ok, keep the \n sequences)
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_BOOKING_TIMEZONE=Asia/Riyadh
# Only set true if Google Workspace Domain-Wide Delegation is configured.
GOOGLE_CALENDAR_SEND_ATTENDEES=false

# ---- App ----
# Used for absolute URLs in emails (booking confirmations, magic links, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Analytics (GA4) ----
# Public: ships in the page source. Empty disables all GA tracking cleanly.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Server-only, for Measurement Protocol conversions.
# GA4 Admin → Data Streams → <stream> → Measurement Protocol API secrets.
# Without it the browser events still work; the server-side conversions don't.
GA_API_SECRET=
