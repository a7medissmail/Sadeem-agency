# ---- Supabase ----
# From your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ---- Resend (transactional email) ----
RESEND_API_KEY=
EMAIL_FROM="SADEEM <hello@yourdomain.com>"
# Team mailbox that receives lead/booking/application notifications
TEAM_NOTIFY_TO=team@yourdomain.com
# Optional. Used to sign marketing unsubscribe links. Falls back to service role key if omitted.
EMAIL_UNSUBSCRIBE_SECRET=

# ---- Google Calendar (Phase 5) ----
GOOGLE_SA_EMAIL=
# Paste the private_key from the service account JSON (multiline ok, keep the \n sequences)
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
# The zone the availability window is written in — "10:00-16:00" means 10:00
# here. Egypt observes DST and Saudi does not, so Africa/Cairo and Asia/Riyadh
# agree all summer and diverge by an hour from late October to late April.
# Picking the wrong one moves every winter booking an hour without warning.
GOOGLE_BOOKING_TIMEZONE=Africa/Cairo
# Only set true if Google Workspace Domain-Wide Delegation is configured.
GOOGLE_CALENDAR_SEND_ATTENDEES=false

# ---- App ----
# Used for absolute URLs in emails (booking confirmations, magic links, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Analytics (GA4) ----
# Public: ships in the page source. Empty disables all GA tracking cleanly.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Server-only, for Measurement Protocol conversions.
# GA4 Admin → Data Streams → <stream> → Measurement Protocol API secrets.
# Without it the browser events still work; the server-side conversions don't.
GA_API_SECRET=

# ---- Admin gate (production) ----
# When set, /admin and /api/admin return a 404 unless the visitor holds the gate
# cookie. Unlock once per device with https://<site>/admin?k=<this value>.
# Leave EMPTY locally and in CI — the e2e suite expects the ungated /admin.
# Generate: openssl rand -hex 24    Rotate it to sign every device out of the gate.
ADMIN_GATE_SECRET=

# ---- Cloudflare Turnstile (required in production) ----
# Without TURNSTILE_SECRET_KEY set, every public form submission is REJECTED
# in production (lib/turnstile.ts fails closed by design).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
